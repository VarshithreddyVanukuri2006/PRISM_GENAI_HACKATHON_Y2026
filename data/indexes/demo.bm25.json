{"format_version": 1, "k1": 1.5, "b": 0.75, "chunks": [{"chunk_id": "8f4d15819f585029e8a1", "repository_id": "cd7953e825f0f280", "file_path": "auth/middleware.py", "language": "Python", "symbol_name": "AuthMiddleware", "symbol_type": "class", "start_line": 4, "end_line": 10, "code": "class AuthMiddleware:\n    \"\"\"Check bearer tokens before protected handlers run.\"\"\"\n\n    def verify_token(self, request):\n        \"\"\"Validate a request token and return its claims.\"\"\"\n        token = extract_token(request.headers)\n        return decode_jwt(token)", "docstring": "Check bearer tokens before protected handlers run.", "imports": ["auth.tokens"], "calls": ["decode_jwt", "extract_token"], "class_name": null, "parent_symbol": null}, {"chunk_id": "dcc9cae17b4d9b8fca8d", "repository_id": "cd7953e825f0f280", "file_path": "auth/middleware.py", "language": "Python", "symbol_name": "AuthMiddleware.verify_token", "symbol_type": "method", "start_line": 7, "end_line": 10, "code": "    def verify_token(self, request):\n        \"\"\"Validate a request token and return its claims.\"\"\"\n        token = extract_token(request.headers)\n        return decode_jwt(token)", "docstring": "Validate a request token and return its claims.", "imports": ["auth.tokens"], "calls": ["decode_jwt", "extract_token"], "class_name": "AuthMiddleware", "parent_symbol": "AuthMiddleware"}, {"chunk_id": "e2dcb42cb68dee17699a", "repository_id": "cd7953e825f0f280", "file_path": "auth/middleware.py", "language": "Python", "symbol_name": "protected_route", "symbol_type": "function", "start_line": 13, "end_line": 15, "code": "def protected_route(request):\n    middleware = AuthMiddleware()\n    return middleware.verify_token(request)", "docstring": "", "imports": ["auth.tokens"], "calls": ["AuthMiddleware", "middleware.verify_token"], "class_name": null, "parent_symbol": null}, {"chunk_id": "b2824ceddaf3fb996303", "repository_id": "cd7953e825f0f280", "file_path": "auth/tokens.py", "language": "Python", "symbol_name": "extract_token", "symbol_type": "function", "start_line": 4, "end_line": 6, "code": "def extract_token(headers):\n    \"\"\"Read a bearer token from request headers.\"\"\"\n    return headers.get(\"Authorization\", \"\").removeprefix(\"Bearer \")", "docstring": "Read a bearer token from request headers.", "imports": ["jwt"], "calls": ["headers.get", "removeprefix"], "class_name": null, "parent_symbol": null}, {"chunk_id": "01a0b5c9ef73fb03aac3", "repository_id": "cd7953e825f0f280", "file_path": "auth/tokens.py", "language": "Python", "symbol_name": "decode_jwt", "symbol_type": "function", "start_line": 9, "end_line": 11, "code": "def decode_jwt(token):\n    \"\"\"Decode and validate a signed JWT.\"\"\"\n    return jwt.decode(token, \"development-secret\", algorithms=[\"HS256\"])", "docstring": "Decode and validate a signed JWT.", "imports": ["jwt"], "calls": ["jwt.decode"], "class_name": null, "parent_symbol": null}, {"chunk_id": "5f71233422e9e48177f6", "repository_id": "cd7953e825f0f280", "file_path": "payments/processor.py", "language": "Python", "symbol_name": "validate_payment", "symbol_type": "function", "start_line": 1, "end_line": 4, "code": "def validate_payment(amount, currency):\n    \"\"\"Reject invalid payment requests before charging.\"\"\"\n    if amount <= 0 or not currency:\n        raise ValueError(\"invalid payment\")", "docstring": "Reject invalid payment requests before charging.", "imports": [], "calls": ["ValueError"], "class_name": null, "parent_symbol": null}, {"chunk_id": "0b8507e4c38a0c4fb9f5", "repository_id": "cd7953e825f0f280", "file_path": "payments/processor.py", "language": "Python", "symbol_name": "charge_card", "symbol_type": "function", "start_line": 7, "end_line": 9, "code": "def charge_card(card, amount):\n    \"\"\"Submit a card charge to the payment provider.\"\"\"\n    return {\"card\": card, \"amount\": amount, \"status\": \"charged\"}", "docstring": "Submit a card charge to the payment provider.", "imports": [], "calls": [], "class_name": null, "parent_symbol": null}, {"chunk_id": "2353a9013db6165f2721", "repository_id": "cd7953e825f0f280", "file_path": "payments/processor.py", "language": "Python", "symbol_name": "process_payment", "symbol_type": "function", "start_line": 12, "end_line": 14, "code": "def process_payment(card, amount, currency):\n    validate_payment(amount, currency)\n    return charge_card(card, amount)", "docstring": "", "imports": [], "calls": ["charge_card", "validate_payment"], "class_name": null, "parent_symbol": null}, {"chunk_id": "45708e5ba9532d78bd8a", "repository_id": "cd7953e825f0f280", "file_path": "storage/images.py", "language": "Python", "symbol_name": "resize_image", "symbol_type": "function", "start_line": 1, "end_line": 3, "code": "def resize_image(image, width, height):\n    \"\"\"Resize an uploaded image to the requested dimensions.\"\"\"\n    return image.resize((width, height))", "docstring": "Resize an uploaded image to the requested dimensions.", "imports": [], "calls": ["image.resize"], "class_name": null, "parent_symbol": null}, {"chunk_id": "9bd18af47e4ad0100f0c", "repository_id": "cd7953e825f0f280", "file_path": "storage/images.py", "language": "Python", "symbol_name": "upload_to_storage", "symbol_type": "function", "start_line": 6, "end_line": 8, "code": "def upload_to_storage(image, bucket):\n    \"\"\"Save image bytes to object storage.\"\"\"\n    return bucket.put_object(image)", "docstring": "Save image bytes to object storage.", "imports": [], "calls": ["bucket.put_object"], "class_name": null, "parent_symbol": null}, {"chunk_id": "fd731696f15949be6784", "repository_id": "cd7953e825f0f280", "file_path": "storage/images.py", "language": "Python", "symbol_name": "upload_image", "symbol_type": "function", "start_line": 11, "end_line": 13, "code": "def upload_image(image, bucket):\n    resized = resize_image(image, 640, 480)\n    return upload_to_storage(resized, bucket)", "docstring": "", "imports": [], "calls": ["res